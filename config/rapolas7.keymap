#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include "zmk-helpers/helper.h"
#include <behaviors/unicode.dtsi>

#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 68 69 80 81
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 69 70 82 83

#define DEF_LAYER 0
#define SYM_LAYER 1
#define NUM_LAYER 2
#define MOU_LAYER 3

/ {
    macros {
        mc_td_a: mc_td_a { compatible = "zmk,behavior-macro"; #binding-cells = <1>; bindings = <&td_a>; };
        mc_td_s: mc_td_s { compatible = "zmk,behavior-macro"; #binding-cells = <1>; bindings = <&td_s>; };
        mc_td_d: mc_td_d { compatible = "zmk,behavior-macro"; #binding-cells = <1>; bindings = <&td_d>; };
        mc_td_f: mc_td_f { compatible = "zmk,behavior-macro"; #binding-cells = <1>; bindings = <&td_f>; };
        mc_td_j: mc_td_j { compatible = "zmk,behavior-macro"; #binding-cells = <1>; bindings = <&td_j>; };
        mc_td_k: mc_td_k { compatible = "zmk,behavior-macro"; #binding-cells = <1>; bindings = <&td_k>; };
        mc_td_l: mc_td_l { compatible = "zmk,behavior-macro"; #binding-cells = <1>; bindings = <&td_l>; };
        mc_td_colon: mc_td_colon { compatible = "zmk,behavior-macro"; #binding-cells = <1>; bindings = <&td_colon>; };
    };

    behaviors {
        hm_a: homerow_mod_a {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&mc_td_a>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };

        hm_s: homerow_mod_s {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mc_td_s>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };

        hm_d: homerow_mod_d {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&mc_td_d>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };

        hm_f: homerow_mod_f {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mc_td_f>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };

        hm_j: homerow_mod_j {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mc_td_j>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
        };

        hm_k: homerow_mod_k {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mc_td_k>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
        };

        hm_l: homerow_mod_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mc_td_l>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
        };

        hm_c: homerow_mod_colon {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mc_td_colon>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
        };

        thumb_ht: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        thumb_mt: thumb_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        td_ao: td_ao { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&uc 0x0105 0>, <&uc 0x0104 0>; };
        td_cc: td_cc { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&uc 0x010D 0>, <&uc 0x010C 0>; };
        td_eo: td_eo { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&uc 0x0119 0>, <&uc 0x0118 0>; };
        td_ed: td_ed { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&uc 0x0117 0>, <&uc 0x0116 0>; };
        td_io: td_io { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&uc 0x012F 0>, <&uc 0x012E 0>; };
        td_sc: td_sc { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&uc 0x0161 0>, <&uc 0x0160 0>; };
        td_uo: td_uo { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&uc 0x0173 0>, <&uc 0x0172 0>; };
        td_um: td_um { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&uc 0x016B 0>, <&uc 0x016A 0>; };
        td_zc: td_zc { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&uc 0x017E 0>, <&uc 0x017D 0>; };
        td_q: td_q { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp Q>, <&kp LS(Q)>; };
        td_w: td_w { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp W>, <&kp LS(W)>; };
        td_e: td_e { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp E>, <&kp LS(E)>; };
        td_r: td_r { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp R>, <&kp LS(R)>; };
        td_t: td_t { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp T>, <&kp LS(T)>; };
        td_y: td_y { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp Y>, <&kp LS(Y)>; };
        td_u: td_u { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp U>, <&kp LS(U)>; };
        td_i: td_i { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp I>, <&kp LS(I)>; };
        td_o: td_o { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp O>, <&kp LS(O)>; };
        td_p: td_p { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp P>, <&kp LS(P)>; };
        td_g: td_g { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp G>, <&kp LS(G)>; };
        td_h: td_h { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp H>, <&kp LS(H)>; };
        td_a: td_a { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp A>, <&kp LS(A)>; };
        td_s: td_s { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp S>, <&kp LS(S)>; };
        td_d: td_d { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp D>, <&kp LS(D)>; };
        td_f: td_f { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F>, <&kp LS(F)>; };
        td_j: td_j { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp J>, <&kp LS(J)>; };
        td_k: td_k { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp K>, <&kp LS(K)>; };
        td_l: td_l { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp L>, <&kp LS(L)>; };
        td_z: td_z { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp Z>, <&kp LS(Z)>; };
        td_x: td_x { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp X>, <&kp LS(X)>; };
        td_c: td_c { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp C>, <&kp LS(C)>; };
        td_v: td_v { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp V>, <&kp LS(V)>; };
        td_b: td_b { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp B>, <&kp LS(B)>; };
        td_n: td_n { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N>, <&kp LS(N)>; };
        td_m: td_m { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp M>, <&kp LS(M)>; };

        td_dash: td_under_hyphen_endash {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp UNDER>, <&kp MINUS>, <&uc 0x2013 0>;
        };
        td_quote: td_startquote_endquote_apostrophe {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&uc 0x201E 0>, <&uc 0x201D 0>, <&kp AMPERSAND>;
        };
        td_comma: td_comma_dot {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp COMMA>, <&kp DOT>;
        };
        td_excl: td_excl_qmark {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp EXCL>, <&kp QMARK>;
        };
        td_colon: td_colon_semicolon {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp COLON>, <&kp SEMI>;
        };
        td_paren: td_openparen_closedparen {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LPAR>, <&kp RPAR>;
        };

        mmv { time-to-max-speed-ms = <300>; };
        msc { time-to-max-speed-ms = <300>; };
    };
};

&uc {
    default-mode = <UC_MODE_WIN_COMPOSE>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp ESCAPE  &td_ao        &td_cc        &td_eo        &td_ed        &td_io    &td_sc   &td_uo        &td_um        &td_zc       &td_paren     &kp ASTERISK
            &kp TAB     &td_q         &td_w         &td_e         &td_r         &td_t     &td_y    &td_u         &td_i         &td_o        &td_p         &none
            &kp LSHIFT  &hm_a LWIN 0  &hm_s LALT 0  &hm_d LCTRL 0 &hm_f LSHFT 0 &td_g     &td_h    &hm_j RSHFT 0 &hm_k RCTRL 0 &hm_l RALT 0 &hm_c RWIN 0  &td_quote
            &kp LCTRL   &td_z         &td_x         &td_c         &td_v         &td_b     &td_n    &td_m         &td_comma     &td_excl     &td_dash      &kp SLASH
            &kp SPACE     &mo NUM_LAYER   &none         &kp ENTER
            &mo MOU_LAYER &mo SYM_LAYER   &kp BACKSPACE &kp DELETE
            >;
        };

        symbol_layer {
            bindings = <
            &none &none &none &none &none &none    &kp GRAVE       &kp LS(GRAVE)   &kp LS(N2)      &kp LS(N3)      &kp LS(N4)   &kp BSLH
            &none &none &none &none &none &none    &kp SQT         &kp LT          &kp GT          &kp LPAR        &kp RPAR     &kp LS(SQT)
            &none &none &none &none &none &none    &kp LS(SEMI)    &kp LBKT        &kp RBKT        &kp LBRC        &kp RBRC     &kp SEMI
            &none &none &none &none &none &none    &kp LS(SLASH)   &kp LS(N1)      &kp LS(N7)      &kp PIPE        &kp LS(N6)   &kp LS(N5)
            &trans &trans &trans &trans
            &trans &trans &trans &trans
            >;
        };

        number_layer {
            bindings = <
            &none &none &none &none &none &none    &none      &none       &kp KP_DIVIDE   &kp KP_MULTIPLY &kp KP_SUBTRACT &none
            &none &none &none &none &none &none    &none      &kp KP_N7   &kp KP_N8       &kp KP_N9       &kp KP_PLUS     &none
            &none &none &none &none &none &none    &none      &kp KP_N4   &kp KP_N5       &kp KP_N6       &kp KP_EQUAL    &none
            &none &none &none &none &none &none    &kp KP_N0  &kp KP_N1   &kp KP_N2       &kp KP_N3       &kp KP_DOT      &kp KP_ENTER
            &trans &trans &trans &trans
            &trans &trans &trans &trans
            >;
        };

        mouse_layer {
            bindings = <
            &none &none &none &none &none &none    &none &mkp LCLK      &mkp MCLK     &mkp RCLK      &none           &none
            &none &none &none &none &none &none    &none &mmv MOVE_LEFT &mmv MOVE_UP  &mmv MOVE_DOWN &mmv MOVE_RIGHT &none
            &none &none &none &none &none &none    &none &msc SCRL_LEFT &msc SCRL_UP  &msc SCRL_DOWN &msc SCRL_RIGHT &none
            &none &none &none &none &none &none    &none &none &none &none &none &none
            &trans &trans &trans &trans
            &trans &trans &trans &trans
            >;
        };
    };
};